@{
    Layout=null;
}

<!DOCTYPE html>
<html>
    <head>
        <title>Sign Up</title>
      <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
  rel="stylesheet">
    </head>

        <body>
           <div class="d-flex justify-content-center align-items-center vh-100">
           <div class="card p-4 shadow" style="width: 350px;">
        <h2 class="text-center mb-4">Let's Sign Up!</h2>
            <form asp-controller="SignUp" asp-action="Signup" method="post">
                <div class="mb-3">
                    <label class="form-label">Enter a Username</label>
                    <input type="text" name="username" class="form-control"> 
                </div>
                    <div class="mb-3">
                        <label class="form-label">Enter a Password</label>
                        <input type="password" name="password" class="form-control">
                    </div>
                        <div class="mb-3">
                            <label class="form-label">Enter an Email Address</label>
                            <input type="text" name="email" class="form-control">
                        </div>
                        <button class="btn btn-primary w-100">Sign Up</button>
            </form>
           </div>
            </div>
        
        </body>
</html>