@{
    Layout=null;
}

<!DOCTYPE html>
<html>
    <head>
        <title>Welcome Page</title>
        <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
  rel="stylesheet">
    </head>

    <body>
            <form asp-controller="LogIn" asp-action="Login" method="get">
        <div class="container w-75 bg-success text-white p-5 mt-4 mx-auto rounded"
     style="min-height: 140px;">
        <div class="text-center">
        <h1>Welcome to Financer!</h1>
        </div>
          <div class="d-flex flex-column justify-content-center align-items-center gap-2">
             <button class="btn btn-primary">Log In</button>
             </form>
             <form asp-controller="SignUp" asp-action="Signup" method="get">
                <button class="btn btn-primary">Sign Up</button>
            </div>
            </form>
                
        </div>
    </body>
</html>